#!/usr/bin/env bash
# scrollfix — reset terminal modes to sane defaults WITHOUT wiping the screen
# or scrollback. Fixes stuck mouse/focus reporting, line-drawing garbage,
# frozen rendering, stuck scroll region, invisible cursor, garbled paste, etc.

# Only act on a real terminal
[ -t 1 ] || exit 0

# Line discipline (echo, canonical mode, flow control). No effect on screen content.
stty sane 2>/dev/null

# Soft terminal reset (DECSTR): restores cursor visibility, origin mode, insert
# mode, etc. to defaults WITHOUT clearing the screen or scrollback. This replaces
# `reset`, which sends RIS (\ec) and nukes the buffer — the whole bug.
printf '\e[!p'

# Make sure we end on the main screen (restores it if a crashed TUI left us on
# the alternate buffer). 1049l restores — it does NOT clear — the main buffer.
printf '\e[?1049l'

# Clear the DEC private modes DECSTR doesn't cover, in one atomic write:
printf '\e[?2004l\e[?1004l\e[?2026l\e[?2031l'    # bracketed paste, focus reporting, sync output, theme-notify
printf '\e[?9l\e[?1000l\e[?1001l\e[?1002l\e[?1003l\e[?1005l\e[?1006l\e[?1007l\e[?1015l\e[?1016l'  # all mouse tracking + encodings
printf '\e[?7h'      # autowrap back on (fixes truncated-at-edge lines)
printf '\e>'         # numeric keypad (DECKPNM)
printf '\e(B\e)B'    # G0/G1 charsets back to ASCII (fixes qqqqlkx line-drawing garbage)
printf '\e[r'        # reset scroll region / margins
printf '\e[m'        # clear colors/attributes
printf '\e[0 q'      # default cursor shape
printf '\e[?25h'     # cursor visible

# Drain any stale input already queued (mouse/focus byte floods) until empty
if [ -t 0 ]; then
    while read -rt 0.05 -n 4096 _discard 2>/dev/null; do :; done
fi

tput cnorm 2>/dev/null
