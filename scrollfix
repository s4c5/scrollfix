# save current screen by switching to alt screen
tput smcup

# turn off bracketed paste mode
printf '\e[?2004l'

# disable mouse/focus reporting modes and show the cursor
printf '\033[?1000l\033[?1002l\033[?1003l\033[?1004l\033[?1005l\033[?1006l\033[?1015l\033[?1016l\033[?25h'

# restore sane terminal settings
stty sane

# full terminal reset
reset

# ensure cursor is visible
tput cnorm

# flush stale input from stdin
read -t 0.1 -n 10000 discard 2>/dev/null

# restore original screen
tput rmcup
